{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robot-investor:bloque-a:paquete-oportunidades:5.1",
  "title": "Paquete de oportunidades del Bloque A (V5.1)",
  "description": "Esquema del entregable 'paquete_oportunidades' (Documento 0 óptima V5.1, secciones 2.4–2.6, 9.6.7, 14.3 y Anexo B). Versión óptima V5.0 · 02/11/2026. Lo genera AG-17 Redactor a partir del paquete de síntesis (CT-15) y lo publica AG-01 Coordinador por CT-02. Las claves de 'clases' son los doce códigos de tipo de activo (2.6). Frontera con el Bloque B (2.5, R21): cada opción es un ÁMBITO de inversión (granularidad máxima: segmento) con su delimitación ('ambito'), su indicador de seguimiento y su invertibilidad; nunca un activo o instrumento concreto, ni sus costes o plataformas. Los nombres concretos solo pueden aparecer en 'ejemplos_ilustrativos'. 'paquete_para_bloque_B' es el encargo de 2.5. Contiene los campos mínimos del Anexo B más las ampliaciones del operador necesarias para los informes (regiones, lo_que_no_sabemos, estado de objeciones, certificados R13). Ampliaciones adicionales solo con prefijo 'x_' (patternProperties); cualquier otro campo no declarado se rechaza para detectar erratas. Las cifras deben coincidir exactamente con el informe técnico y el informe visual del mismo run_id. Actualizado V5.1 (03/11/2026): horizonte H5 (décadas) con banda cualitativa e hitos HIT-, `naturaleza_inversion` y `horizonte_principal` obligatorios por opción (regla de adecuación, 8.3), `supuestos_declarados` (CT-23).",
  "type": "object",
  "required": [
    "run_id",
    "fecha",
    "methodology_version",
    "tipo",
    "regimen_macro",
    "apuestas_independientes",
    "clases",
    "seguimiento_vigentes",
    "historial_aciertos",
    "paquete_para_bloque_B",
    "preguntas_sugeridas",
    "limitaciones"
  ],
  "properties": {
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de referencia del análisis (AAAA-MM-DD)."
    },
    "fecha_datos_mercado": {
      "type": "string",
      "format": "date",
      "description": "Fecha del último cierre de mercado usado (HT-01)."
    },
    "methodology_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Versión de metodología vigente en F10 (p. ej. 5.0, 5.1)."
    },
    "tipo": {
      "enum": [
        "PERIODICO",
        "AD_HOC",
        "PROFUNDIZACION"
      ]
    },
    "nivel_por_clase": {
      "type": "object",
      "description": "Nivel N1–N3 aplicado a cada tipo de activo en este RUN.",
      "propertyNames": {
        "$ref": "#/$defs/codigo_clase"
      },
      "additionalProperties": {
        "enum": [
          "N1",
          "N2",
          "N3"
        ]
      }
    },
    "regimen_macro": {
      "type": "string",
      "minLength": 10
    },
    "apuestas_independientes": {
      "type": "integer",
      "minimum": 0,
      "description": "Número de grupos de opciones que dependen del mismo factor dominante (9.6.6)."
    },
    "clusteres_exposicion": {
      "type": "array",
      "description": "Detalle de las apuestas independientes: factor dominante y opciones que dependen de él.",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "factor_dominante",
          "opp_ids"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "pattern": "^CL-[0-9]{1,3}$"
          },
          "factor_dominante": {
            "type": "string"
          },
          "opp_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/opp_id"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "clases": {
      "type": "object",
      "description": "Una entrada por cada tipo de activo activo en F10 (los doce por defecto). En cada tipo, el 'tipo_activo' de sus opciones coincide con la clave.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "RV": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "RV"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "RF": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "RF"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "DIV": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "DIV"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "MP": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "MP"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "IDX": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "IDX"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "FON": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "FON"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "DER": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "DER"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "INM": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "INM"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "CRI": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "CRI"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "ALT": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "ALT"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "MON": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "MON"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "TCV": {
          "allOf": [
            {
              "$ref": "#/$defs/clase"
            },
            {
              "properties": {
                "opciones": {
                  "items": {
                    "properties": {
                      "tipo_activo": {
                        "const": "TCV"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "seguimiento_vigentes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "opp_id",
          "estado",
          "comentario"
        ],
        "properties": {
          "opp_id": {
            "$ref": "#/$defs/opp_id"
          },
          "estado": {
            "enum": [
              "VIGENTE",
              "CERRADA"
            ]
          },
          "motivo_cierre": {
            "enum": [
              "INVALIDACION",
              "VENCIMIENTO_HORIZONTE",
              "OBJETIVO_ALCANZADO",
              "SUSTITUCION",
              null
            ]
          },
          "comentario": {
            "type": "string"
          },
          "decision_broker": {
            "enum": [
              "ENVIADA_A_BLOQUE_B",
              "EN_SEGUIMIENTO",
              "DESCARTADA",
              "APLAZADA",
              null
            ]
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "estado": {
              "const": "CERRADA"
            }
          }
        },
        "then": {
          "required": [
            "motivo_cierre"
          ],
          "properties": {
            "motivo_cierre": {
              "type": "string"
            }
          }
        }
      }
    },
    "historial_aciertos": {
      "$ref": "#/$defs/historial_aciertos"
    },
    "paquete_para_bloque_B": {
      "type": "array",
      "description": "Encargo para el Bloque B (2.5, Anexo B): una entrada por cada opción del top-3 (la decisión de reenviar es del Broker, R4).",
      "items": {
        "$ref": "#/$defs/entrada_bloque_B"
      }
    },
    "preguntas_sugeridas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "limitaciones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "estado_g3": {
      "enum": [
        "APTO",
        "APTO_CON_ADVERTENCIAS"
      ]
    },
    "aviso_legal": {
      "type": "string"
    },
    "supuestos_declarados": {
      "type": "array",
      "description": "Supuestos aplicados por consultas al Broker (CT-23) sin respuesta (6.2.9); el Redactor los muestra y HT-09 los comprueba (C19).",
      "items": {
        "type": "object",
        "required": [
          "supuesto",
          "cns_id"
        ],
        "properties": {
          "supuesto": {
            "type": "string",
            "minLength": 5
          },
          "cns_id": {
            "$ref": "#/$defs/cns_id"
          },
          "efecto_si_falso": {
            "type": "string"
          },
          "clases": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/codigo_clase"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}-[0-9]{4,}$"
    },
    "opp_id": {
      "type": "string",
      "pattern": "^OPP-[0-9]{4}-[0-9]{4,}$"
    },
    "tnd_id": {
      "type": "string",
      "pattern": "^TND-[0-9]{4}-[0-9]{4,}$"
    },
    "prg_id": {
      "type": "string",
      "pattern": "^PRG-[0-9]{4}-[0-9]{4,}$"
    },
    "clm_id": {
      "type": "string",
      "pattern": "^CLM-[0-9]{4}-[0-9]{4,}$"
    },
    "calc_id": {
      "type": "string",
      "pattern": "^CALC-[0-9]{4}-[0-9]{4,}$"
    },
    "codigo_clase": {
      "enum": [
        "RV",
        "RF",
        "DIV",
        "MP",
        "IDX",
        "FON",
        "DER",
        "INM",
        "CRI",
        "ALT",
        "MON",
        "TCV"
      ],
      "description": "Doce tipos de activo (2.6): RV renta variable · RF renta fija · DIV divisas · MP materias primas · IDX índices bursátiles · FON fondos y vehículos de inversión colectiva · DER derivados financieros · INM activos inmobiliarios cotizados · CRI criptoactivos y activos digitales · ALT capital privado y activos alternativos · MON instrumentos monetarios y liquidez · TCV tipos de interés, crédito y volatilidad."
    },
    "codigo_region": {
      "enum": [
        "NAM",
        "LAT",
        "EUR",
        "AFR",
        "ORM",
        "CHN",
        "ASE",
        "JPN",
        "OCE",
        "GLB"
      ],
      "description": "Regiones del cartograma del informe visual: Norteamérica, Latinoamérica, Europa, África, Oriente Medio, China, Asia emergente, Japón, Oceanía, Global (sin región)."
    },
    "horizonte": {
      "enum": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5"
      ],
      "description": "H1 días · H2 semanas · H3 meses · H4 años (1–5) · H5 décadas (5–30) (8.3)."
    },
    "puntuacion_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "multipleOf": 5
    },
    "confianza": {
      "enum": [
        "establecido",
        "probable",
        "especulativo",
        "en disputa"
      ]
    },
    "clase": {
      "type": "object",
      "required": [
        "estado_semaforo",
        "regimen_clase",
        "candidatas_analizadas",
        "opciones",
        "menos_de_tres_motivo"
      ],
      "properties": {
        "estado_semaforo": {
          "enum": [
            "VERDE",
            "AMBAR",
            "GRIS"
          ]
        },
        "regimen_clase": {
          "type": "string",
          "minLength": 10
        },
        "candidatas_analizadas": {
          "type": "integer",
          "minimum": 0
        },
        "embudo": {
          "type": "object",
          "description": "Recuento por puerta de continuidad (F5).",
          "properties": {
            "gc0_delta_material": {
              "type": "boolean"
            },
            "cribadas": {
              "type": "integer",
              "minimum": 0
            },
            "pasan_gc1": {
              "type": "integer",
              "minimum": 0
            },
            "pasan_gc2": {
              "type": "integer",
              "minimum": 0
            },
            "finalistas_gc3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "elegibles": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "opciones": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/opcion"
          }
        },
        "menos_de_tres_motivo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Obligatorio (texto) si hay menos de tres opciones (R14): cuántas se analizaron, por qué no llegaron y qué tendría que ocurrir."
        }
      },
      "patternProperties": {
        "^x_": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "opciones": {
                "maxItems": 2
              }
            }
          },
          "then": {
            "properties": {
              "menos_de_tres_motivo": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estado_semaforo": {
                "const": "GRIS"
              }
            }
          },
          "then": {
            "properties": {
              "opciones": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estado_semaforo": {
                "enum": [
                  "VERDE",
                  "AMBAR"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "opciones": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "Resultado de un tipo de activo: semáforo, régimen, embudo y hasta tres opciones (R14)."
    },
    "opcion": {
      "type": "object",
      "required": [
        "opp_id",
        "rango",
        "tipo_opcion",
        "tipo_activo",
        "subtipo",
        "nombre",
        "nombre_llano",
        "tesis",
        "mecanismo",
        "tnd_ids",
        "regiones",
        "puntuaciones",
        "horizontes",
        "valoracion",
        "catalizadores",
        "riesgos",
        "riesgo_1a5",
        "invalidacion",
        "ambito",
        "indicador_seguimiento",
        "invertibilidad",
        "liquidez",
        "relevancia_decisional",
        "reversibilidad",
        "siguiente_paso_sugerido",
        "que_cambiaria_la_conclusion",
        "objeciones",
        "lo_que_no_sabemos",
        "confianza",
        "evidencias",
        "calculos",
        "naturaleza_inversion",
        "horizonte_principal"
      ],
      "properties": {
        "opp_id": {
          "$ref": "#/$defs/opp_id"
        },
        "rango": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "tipo_opcion": {
          "enum": [
            "MERCADO",
            "SECTOR",
            "SUBSECTOR",
            "TEMATICA",
            "SEGMENTO",
            "FACTOR",
            "ESTILO",
            "ESTRATEGIA"
          ],
          "description": "Granularidad del ámbito (2.4): MERCADO (país, región o índice de referencia), SECTOR, SUBSECTOR, TEMATICA, SEGMENTO (subconjunto por rating, vencimiento, tamaño, estilo o estructura), FACTOR, ESTILO o ESTRATEGIA. Nunca un activo concreto (R21)."
        },
        "tipo_activo": {
          "$ref": "#/$defs/codigo_clase",
          "description": "Tipo de activo asignado según las reglas de 2.6 (motor de rentabilidad). Coincide con la clave de 'clases'."
        },
        "tipos_secundarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/codigo_clase"
          },
          "description": "Tipos secundarios citados (regla 5 de 2.6); la opción solo figura en el top-3 de su tipo principal."
        },
        "subtipo": {
          "type": "string",
          "minLength": 2,
          "description": "Subtipo de la tabla 2.6 dentro del que se delimita el ámbito (p. ej., «Sector», «Deuda pública», «Metales preciosos», «Volatilidad»)."
        },
        "nombre": {
          "type": "string",
          "minLength": 3
        },
        "nombre_llano": {
          "type": "string",
          "minLength": 3,
          "maxLength": 70
        },
        "por_que_llano": {
          "type": "string",
          "maxLength": 160,
          "description": "Frase de la tarjeta del informe visual (≤ 20 palabras)."
        },
        "que_puede_salir_mal_llano": {
          "type": "string",
          "maxLength": 200
        },
        "tesis": {
          "type": "string",
          "minLength": 10
        },
        "mecanismo": {
          "type": "string",
          "minLength": 10
        },
        "tnd_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tnd_id"
          },
          "description": "Vacío solo en oportunidades tácticas sin tendencia estructural (T = NA)."
        },
        "cluster_id": {
          "type": "string",
          "pattern": "^CL-[0-9]{1,3}$"
        },
        "regiones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/codigo_region"
          }
        },
        "puntuaciones": {
          "$ref": "#/$defs/puntuaciones"
        },
        "horizontes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/horizonte"
          },
          "properties": {
            "H5": {
              "$ref": "#/$defs/vista_h5"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/vista_horizonte"
          }
        },
        "horizonte_principal": {
          "$ref": "#/$defs/horizonte",
          "description": "Horizonte en el que la opción expresa su tesis central (8.3); debe figurar en 'horizontes', ser aplicable a su tipo y estar en el rango de su naturaleza (HT-09 C17)."
        },
        "valoracion": {
          "type": "string",
          "minLength": 10
        },
        "catalizadores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evento",
              "fecha"
            ],
            "properties": {
              "evento": {
                "type": "string"
              },
              "fecha": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$|^[0-9]{4}-T[1-4]$|^[0-9]{4}-S[12]$",
                "description": "AAAA-MM-DD, AAAA-MM, AAAA-Tn (trimestre) o AAAA-Sn (semestre)."
              }
            },
            "additionalProperties": false
          }
        },
        "riesgos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "riesgo_1a5": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "invalidacion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ambito": {
          "$ref": "#/$defs/ambito"
        },
        "indicador_seguimiento": {
          "$ref": "#/$defs/indicador_seguimiento"
        },
        "invertibilidad": {
          "$ref": "#/$defs/invertibilidad"
        },
        "ejemplos_ilustrativos": {
          "$ref": "#/$defs/ejemplos_ilustrativos"
        },
        "liquidez": {
          "enum": [
            "alta",
            "media",
            "baja"
          ],
