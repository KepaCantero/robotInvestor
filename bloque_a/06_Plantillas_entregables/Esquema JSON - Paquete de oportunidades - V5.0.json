            "properties": {
              "fuerza": {
                "const": "fuerte"
              }
            }
          },
          "then": {
            "properties": {
              "estado": {
                "const": "RESPONDIDA"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estado": {
                "const": "RESPONDIDA"
              }
