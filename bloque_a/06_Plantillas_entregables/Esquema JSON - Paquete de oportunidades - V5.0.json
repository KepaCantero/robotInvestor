          }
        },
        "calculos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/calc_id"
          }
        },
        "minigrafico": {
          "type": "object",
          "description": "Instrucción para HT-04: qué gráfico acompaña a la tarjeta del informe visual.",
          "required": [
            "tipo"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "PRECIO_CON_ZONA",
                "VALORACION_VS_MEDIA",
                "NINGUNO"
              ]
            },
            "serie_ref": {
              "type": "string"
            },
            "zona_interes": {
              "type": "object",
              "required": [
                "min",
                "max",
                "unidad"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "unidad": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "calc_id": {
              "$ref": "#/$defs/calc_id"
            }
          },
          "additionalProperties": false
        },
        "puertas": {
          "type": "object",
          "description": "Resultado de G1–G4 y PS1–PS8 (usado por HT-09; PS3 = invertibilidad del ámbito). Valores: SUPERADA | SUPERADA_CON_NOTA | NO_SUPERADA | NA, o booleanos.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cluster": {
          "type": "string",
          "description": "Clúster de exposición (alias aceptado de cluster_id, usado por HT-03/HT-09)."
        },
        "vigente": {
          "type": "boolean",
          "description": "true si la opción ya estaba en el top-3 del ciclo anterior (regla de continuidad 9.6.4)."
        },
        "desglose": {
          "type": "object",
          "description": "Dimensiones de cada puntuación (T, E, M, P, A) para reconstruirlas con HT-03. A: asimetria 30, valoracion 25, catalizadores 15, momento 15, invertibilidad 15 (9.1).",
          "additionalProperties": {
            "type": "object"
          }
        },
        "segunda_pasada": {
          "type": [
            "boolean",
            "object"
          ],
          "description": "Indica si hubo segunda pasada por banda marginal (PS8)."
        },
        "advertencia_h1": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Advertencia obligatoria de baja fiabilidad en horizontes de días (8.3)."
        },
        "naturaleza_inversion": {
          "$ref": "#/$defs/naturaleza_inversion"
        },
        "justificacion_horizonte": {
          "type": [
            "string",
            "null"
          ],
          "description": "Obligatoria si el horizonte principal queda fuera del rango de su naturaleza (8.3)."
        }
      },
      "patternProperties": {
        "^x_": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Oportunidad táctica: con T = NA se exige A ≥ 65 (9.2).",
          "if": {
            "properties": {
              "puntuaciones": {
                "properties": {
                  "T": {
                    "const": "NA"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "puntuaciones": {
                "properties": {
                  "A": {
                    "minimum": 65
                  }
                }
              }
            }
          }
        },
        {
          "description": "Con riesgo ≥ 4 la relevancia decisional es ALTA (Anexo A).",
          "if": {
            "properties": {
              "riesgo_1a5": {
                "minimum": 4
              }
            }
          },
          "then": {
            "properties": {
              "relevancia_decisional": {
                "const": "ALTA"
              }
            }
          }
        },
        {
          "description": "Con reversibilidad baja la relevancia decisional es ALTA (Anexo A).",
          "if": {
            "properties": {
              "reversibilidad": {
                "const": "baja"
              }
            }
          },
          "then": {
            "properties": {
              "relevancia_decisional": {
                "const": "ALTA"
              }
            }
          }
        }
      ]
    },
    "puntuaciones": {
      "type": "object",
      "required": [
        "T",
        "E",
        "M",
        "A",
        "RK",
        "desglose_ref"
      ],
      "properties": {
        "T": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 50,
              "maximum": 100,
              "multipleOf": 5
            },
            {
              "const": "NA"
            }
          ],
          "description": "Elegibilidad: T ≥ 50 o NA en oportunidades tácticas."
        },
        "E": {
          "type": "integer",
          "minimum": 60,
          "maximum": 100,
          "multipleOf": 5,
          "description": "Elegibilidad: E ≥ 60."
        },
        "M": {
          "$ref": "#/$defs/puntuacion_total"
        },
        "A": {
          "type": "integer",
          "minimum": 55,
          "maximum": 100,
          "multipleOf": 5,
          "description": "Elegibilidad: A ≥ 55."
        },
        "P": {
          "$ref": "#/$defs/puntuacion_total"
        },
        "RK": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Clave de ordenación calculada por HT-03; no es probabilidad ni rentabilidad."
        },
        "desglose_ref": {
          "type": "string",
          "minLength": 3,
          "description": "Identificador del cálculo HT-03 con el desglose por dimensiones."
        }
      },
      "additionalProperties": false
    },
    "vista_horizonte": {
      "type": "object",
      "required": [
        "vista",
        "banda",
        "prob",
        "prg_id",
        "certificado_r13"
      ],
      "properties": {
        "vista": {
          "enum": [
            "alcista",
            "bajista",
            "lateral",
            "relativa_favorable",
            "relativa_desfavorable"
          ]
        },
        "banda": {
          "enum": [
            "muy probable",
            "más probable que no",
            "incierto",
            "poco probable",
            "muy poco probable"
          ]
        },
        "prob": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "certificado_r13": {
          "type": "boolean",
          "description": "true solo si el Evaluador certificó la celda tipo de activo × horizonte (R13)."
        },
        "etiqueta": {
          "type": "string",
          "description": "«sin ventaja demostrada todavía» cuando no hay certificado."
        },
        "prg_id": {
          "$ref": "#/$defs/prg_id"
        },
        "fecha_resolucion": {
          "type": "string",
          "format": "date"
        },
        "criterio_resolucion": {
          "type": "string"
        },
        "hitos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hito"
          },
          "description": "Solo en H5: ≥ 3 hitos HIT- (Anexo A)."
        },
        "tesis_estructural": {
          "type": "string",
          "description": "Solo en H5: tesis estructural de largo plazo."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "R13: probabilidad numérica solo con certificado.",
          "if": {
            "properties": {
              "certificado_r13": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "prob": {
                "type": "null"
              }
            },
            "required": [
              "etiqueta"
            ]
          }
        }
      ]
