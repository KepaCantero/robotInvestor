# Plantilla de .env. Cópiala a la raíz del repositorio como .env (está en .gitignore) y rellena solo lo que uses.
# Los scripts de .docs/scripts/ la cargan a través de common.sh. Nunca escribas un secreto dentro de un script.

# GITHUB_TOKEN=          # solo si git push o gh lo necesitan en tu máquina
# ANTHROPIC_API_KEY=     # modo sombra con la API real (Fase 5)
# OPENAI_API_KEY=        # ídem, para modelos de OpenAI
# GIT_AUTOR_NOMBRE=      # autor de los commits que hace commit.sh (por defecto, tu git config)
# GIT_AUTOR_EMAIL=
# GIT_TRAILERS=          # líneas finales del mensaje de commit, separadas por \n (p. ej. Co-Authored-By de tu agente)
